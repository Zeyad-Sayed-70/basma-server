# ─── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=basma
DB_USER=basma
DB_PASSWORD=basma_secret

DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ─── Redis ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── MinIO ────────────────────────────────────────────
MINIO_ROOT_USER=basma
MINIO_ROOT_PASSWORD=basma_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=basma
MINIO_SECRET_KEY=basma_secret
MINIO_BUCKET=basma-assets

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=7d

# ─── WhatsApp / Baileys ──────────────────────────────
REDIS_URL=redis://localhost:6379
WA_MESSAGE_RATE_LIMIT=12
WA_MAX_RECONNECT_ATTEMPTS=10
WA_RECONNECT_BASE_DELAY=1000

# ─── Paymob ────────────────────────────────────────────
PAYMOB_ENCRYPTION_KEY=           # 32+ character key for AES-256 encryption of stored secrets
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_WEBHOOK_BASE_URL=         # public URL for webhook (ngrok in dev)
FRONTEND_BASE_URL=               # frontend URL for redirect after payment

# ─── AI Agent / OpenCode ────────────────────────────────
OPENCODE_SERVER_HOSTNAME=127.0.0.1
OPENCODE_SERVER_PORT=4096
OPENCODE_ZEN_MODEL=opencode/deepseek-v3-0324

# ─── NVIDIA NIM (Fallback model) ────────────────────────
NIM_API_KEY=                       # NVIDIA NIM API key (for rate-limit fallback)
NIM_MODEL=nvidia/deepseek-r1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── YouTube (video pipeline) ─────────────────────────
YT_CLIENT_ID=                      # Google Cloud OAuth client ID for YouTube Data API v3
YT_CLIENT_SECRET=                   # Google Cloud OAuth client secret
                                     # IMPORTANT: In Google Cloud Console → Credentials → OAuth 2.0 Client IDs,
                                     #   add "urn:ietf:wg:oauth:2.0:oob" to "Authorized redirect URIs"
YT_ENCRYPTION_KEY=change-me-32character-key-here!   # Any passphrase (SHA-256 hashed to derive 32-byte AES key)
YT_COOKIES_FILE=./data/yt-cookies.txt               # Netscape cookies file for yt-dlp auth
YT_COOKIES_REFRESH_ENABLED=true                     # Enable Camoufox cookie refresher
YT_PROFILE_DIR=./data/pw-profile                    # Persistent Camoufox browser profile dir
CAMOUFOX_INSTALL_DIR=                               # Override Camoufox browser cache dir (defaults to ~/.cache/camoufox on Linux, %LOCALAPPDATA%/camoufox on Windows)
YT_TEMP_DIR=./tmp/uploads                           # Temp directory for large video files
YT_BROWSER_COOKIES=                                  # Alternative: 'chrome' for --cookies-from-browser
YT_UPLOAD_RATE_PER_MIN=10                           # Max YouTube uploads per minute

# ─── Upload limits ─────────────────────────────────────
MAX_VIDEO_UPLOAD_BYTES=4294967296                   # 4 GiB default cap

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=log                                        # trace|debug|log|warn|error
