generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  MUBTADI
  MUHTARIF
  KHEBIR
  HOUT
}

enum RegistrationMode {
  OPEN
  CLOSED
}

enum LandingPageStatus {
  DRAFT
  PUBLISHED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum QuestionType {
  MCQ
  THEORY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum WhatsAppSessionStatus {
  DISCONNECTED
  CONNECTING
  CONNECTED
  QR_PENDING
  PAIRING_PENDING
  BANNED
  LOGGED_OUT
}

enum NotificationType {
  SESSION_REMINDER
  QUIZ_GRADED
  ASSIGNMENT_DUE
  CUSTOM
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
  CANCELLED
}

enum SessionType {
  LOCAL
  ONLINE
}

enum SessionPlatform {
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  OTHER
}

enum ChatSenderRole {
  TEACHER
  STUDENT
}

enum CurriculumElementType {
  VIDEO
  RICH_CONTENT
  FILE
  QUIZ
  ASSIGNMENT
  SESSION
}

enum ElementProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum VideoJobStatus {
  PENDING
  PROCESSING
  CANCELLED
  COMPLETED
  FAILED
}

model Instance {
  id             String    @id @default(cuid())
  name           String
  subdomain      String    @unique
  tier           Tier      @default(MUBTADI)
  tierExpiresAt  DateTime?
  tierRenewedAt  DateTime?
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teacher       Teacher?
  brand         Brand?
  groups        Group[]
  students      Student[]
  courses       Course[]
  sessions      Session[]
  quizzes       Quiz[]
  assignments   Assignment[]
  notifications Notification[]
  paymobConfig  PaymobConfig?
  payments      Payment[]
  questions     QuestionBank[]
  chatMessages      ChatMessage[]
  chatReadMarkers   ChatReadMarker[]
  agentSpaceFiles   AgentSpaceFile[]
  agentStudentNotes AgentStudentNote[]
  agentConversations AgentConversation[]
  agentMessages      AgentMessage[]

  whatsappSession         WhatsAppSession?
  notificationPreferences NotificationPreference[]
  curricula               Curriculum[]

  landingPage           LandingPage?
  tierChangeLogs        TierChangeLog[]
  onboardingAnswers     Json?               @map("onboarding_answers")
  onboardingCompleted   Boolean             @default(false) @map("onboarding_completed")

  @@map("instances")
}

model WhatsAppSession {
  id              String                @id @default(cuid())
  instanceId      String                @unique
  instance        Instance              @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  phoneNumber     String?
  status          WhatsAppSessionStatus @default(DISCONNECTED)
  lastConnectedAt DateTime?
  lastError       String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([instanceId])
  @@map("whatsapp_sessions")
}

model NotificationPreference {
  id         String           @id @default(cuid())
  type       NotificationType
  enabled    Boolean          @default(true)
  instanceId String
  instance   Instance         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([instanceId, type])
  @@map("notification_preferences")
}

model Teacher {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  lang         String   @default("ar")
  instanceId   String   @unique
  instance     Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("teachers")
}

model Brand {
  id                      String    @id @default(cuid())
  logoUrl                 String?
  logoFileSize            Int?
  primaryColor            String    @default("#2563eb")
  secondaryColor          String    @default("#1e40af")
  fontFamily              String    @default("Cairo")
  customDomain            String?   @unique
  customDomainVerifiedAt  DateTime?
  customDomainVerifyToken String?
  whiteLabelEnabled       Boolean   @default(false)
  instanceId              String    @unique
  instance                Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("brands")
}

model LandingPage {
  id             String            @id @default(cuid())
  instanceId     String            @unique
  instance       Instance          @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  status         LandingPageStatus @default(DRAFT)
  locale         String            @default("ar")
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?
  content        Json
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("landing_pages")
}

model Group {
  id               String           @id @default(cuid())
  name             String
  description      String?
  registrationMode RegistrationMode @default(OPEN)
  invitationCode   String?          @unique
  instanceId       String
  instance         Instance         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  students     Student[]
  courses      Course[]
  chatMessages    ChatMessage[]
  chatReadMarkers ChatReadMarker[]

  @@unique([instanceId, name])
  @@index([instanceId])
  @@map("groups")
}

model Student {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  passwordHash String?
  status       StudentStatus @default(ACTIVE)
  groupId      String
  group      Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instanceId String
  instance   Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  agentProfile          Json                  @default("{}")
  agentConversations    AgentConversation[]
  agentNotes            AgentStudentNote[]

  enrollments           CourseEnrollment[]
  quizAttempts          StudentQuizAttempt[]
  assignmentSubmissions StudentAssignmentSubmission[]
  payments              Payment[]
  elementProgress       ElementProgress[]
  courseProgress        CourseProgress[]

  @@unique([instanceId, email])
  @@index([groupId])
  @@index([instanceId])
  @@map("students")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float    @default(0)
  imageUrl    String?
  imageFileSize Int?
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instanceId  String
  instance    Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    Session[]
  quizzes     Quiz[]
  assignments Assignment[]
  enrollments CourseEnrollment[]
  payments    Payment[]
  curriculum  Curriculum?

  @@index([groupId])
  @@index([instanceId])
  @@map("courses")
}

model CourseEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  instanceId String

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

model Session {
  id         String           @id @default(cuid())
  title      String
  startTime  DateTime
  endTime    DateTime?
  type       SessionType      @default(LOCAL)
  location   String?
  platform   SessionPlatform?
  meetingUrl String?
  notes      String?
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instanceId String
  instance   Instance         @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  curriculumElements CurriculumElement[]

  @@index([courseId])
  @@index([instanceId])
  @@map("sessions")
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  totalMarks  Int      @default(0)
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instanceId  String
  instance    Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions          QuizQuestion[]
  attempts           StudentQuizAttempt[]
  curriculumElements CurriculumElement[]

  @@index([courseId])
  @@index([instanceId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType @default(MCQ)
  options       Json         @default("[]")
  correctAnswer String?
  marks         Int          @default(1)
  quizId        String
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  instanceId    String

  @@index([quizId])
  @@map("quiz_questions")
}

model StudentQuizAttempt {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score       Int?
  answers     Json     @default("[]")
  submittedAt DateTime @default(now())
  instanceId  String

  @@unique([studentId, quizId])
  @@index([quizId])
  @@map("student_quiz_attempts")
}

model Assignment {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  maxGrade    Int       @default(100)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instanceId  String
  instance    Instance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submissions        StudentAssignmentSubmission[]
  curriculumElements CurriculumElement[]

  @@index([courseId])
  @@index([instanceId])
  @@map("assignments")
}

model StudentAssignmentSubmission {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  fileSize     Int?
  grade        Int?
  feedback     String?
  submittedAt  DateTime   @default(now())
  instanceId   String

  @@unique([studentId, assignmentId])
  @@index([assignmentId])
  @@map("student_assignment_submissions")
}

model Notification {
  id             String             @id @default(cuid())
  type           NotificationType
  title          String
  body           String
  recipientPhone String?
  status         NotificationStatus @default(PENDING)
  instanceId     String
  instance       Instance           @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  logs NotificationLog[]

  @@index([instanceId])
  @@index([status])
  @@map("notifications")
}

model NotificationLog {
  id              String             @id @default(cuid())
  notificationId  String
  notification    Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipientPhone  String
  status          NotificationStatus @default(PENDING)
  waMessageId     String?
  error           String?
  attempts        Int                @default(0)
  lastAttemptedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([notificationId])
  @@index([status])
  @@map("notification_logs")
}

model PaymobConfig {
  id                  String   @id @default(cuid())
  instanceId          String   @unique
  instance            Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  secretKey           String
  publicKey           String
  hmacSecret          String
  cardIntegrationId   Int?
  walletIntegrationId Int?
  mode                String   @default("test")
  isConfigured        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("paymob_configs")
}

model Payment {
  id                  String        @id @default(cuid())
  studentId           String
  student             Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId            String?
  course              Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  amountCents         Int
  currency            String        @default("EGP")
  status              PaymentStatus @default(PENDING)
  paymobIntentionId   String?
  paymobOrderId       String?
  paymobTransactionId String?
  clientSecret        String?
  specialReference    String?       @unique
  notes               String?
  metadata            Json          @default("{}")
  instanceId          String
  instance            Instance      @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([studentId])
  @@index([courseId])
  @@index([instanceId])
  @@index([status])
  @@index([paymobOrderId])
  @@map("payments")
}

model QuestionBank {
  id            String       @id @default(cuid())
  text          String
  type          QuestionType @default(MCQ)
  options       Json         @default("[]")
  correctAnswer String?
  category      String?
  difficulty    Difficulty   @default(MEDIUM)
  instanceId    String
  instance      Instance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([instanceId])
  @@index([category])
  @@map("question_bank")
}

model ChatMessage {
  id         String         @id @default(cuid())
  content    String
  senderId   String
  senderRole ChatSenderRole
  fileUrl    String?
  fileSize   Int?
  groupId    String
  group      Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  instanceId String
  instance   Instance       @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@index([groupId])
  @@index([instanceId])
  @@map("chat_messages")
}

model ChatReadMarker {
  id         String   @id @default(cuid())
  userId     String
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lastReadAt DateTime
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([instanceId])
  @@map("chat_read_markers")
}

model AgentSpaceFile {
  id         String   @id @default(cuid())
  filename   String
  content    String
  fileType   String   @default("md")
  fileSize   Int      @default(0)
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([instanceId, filename])
  @@index([instanceId])
  @@map("agent_space_files")
}

model AgentStudentNote {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  category   String   @default("general")
  content    String
  source     String   @default("agent")
  sessionId  String?
  createdAt  DateTime @default(now())

  @@index([studentId])
  @@index([instanceId])
  @@index([category])
  @@map("agent_student_notes")
}

model AgentConversation {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instanceId        String
  instance          Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  opencodeSessionId String?
  title             String?
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages AgentMessage[]

  @@index([studentId])
  @@index([instanceId])
  @@map("agent_conversations")
}

model AgentMessage {
  id             String   @id @default(cuid())
  conversationId String
  conversation   AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolCalls      Json?
  model          String?
  instanceId     String
  instance       Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([instanceId])
  @@map("agent_messages")
}

model Curriculum {
  id         String   @id @default(cuid())
  courseId   String   @unique
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instanceId String
  instance   Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  elements CurriculumElement[]
  videos   CurriculumVideo[]
  files    CurriculumFile[]
  richContents CurriculumRichContent[]
  images   CurriculumImage[]

  @@index([instanceId])
  @@map("curricula")
}

model CurriculumElement {
  id             String               @id @default(cuid())
  curriculumId   String
  curriculum     Curriculum           @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  instanceId     String
  type           CurriculumElementType
  title          String
  position       Int
  required       Boolean              @default(true)

  videoId        String?              @unique
  video          CurriculumVideo?     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  richContentId  String?              @unique
  richContent    CurriculumRichContent? @relation(fields: [richContentId], references: [id], onDelete: Cascade)
  fileId         String?              @unique
  file           CurriculumFile?      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  quizId         String?
  quiz           Quiz?                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  sessionId      String?
  session        Session?             @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  progress ElementProgress[]

  @@unique([curriculumId, position])
  @@unique([curriculumId, quizId])
  @@unique([curriculumId, assignmentId])
  @@unique([curriculumId, sessionId])
  @@index([curriculumId])
  @@index([instanceId])
  @@map("curriculum_elements")
}

model CurriculumVideo {
  id              String   @id @default(cuid())
  curriculumId    String
  curriculum      Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  instanceId      String
  title           String
  description     String?
  videoUrl        String
  fileObjectKey   String
  mimeType        String
  fileSize        Int
  durationSeconds Int?
  createdAt       DateTime @default(now())

  element CurriculumElement?

  @@index([curriculumId])
  @@index([instanceId])
  @@map("curriculum_videos")
}

model CurriculumFile {
  id            String   @id @default(cuid())
  curriculumId  String
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  instanceId    String
  title         String
  description   String?
  filename      String
  fileUrl       String
  fileObjectKey String
  mimeType      String
  fileSize      Int
  createdAt     DateTime @default(now())

  element CurriculumElement?

  @@index([curriculumId])
  @@index([instanceId])
  @@map("curriculum_files")
}

model CurriculumRichContent {
  id           String   @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  instanceId   String
  title        String
  bodyJson     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  element CurriculumElement?

  @@index([curriculumId])
  @@index([instanceId])
  @@map("curriculum_rich_content")
}

model CurriculumImage {
  id            String   @id @default(cuid())
  curriculumId  String
  curriculum    Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  instanceId    String
  fileUrl       String
  fileObjectKey String
  mimeType      String
  fileSize      Int
  createdAt     DateTime @default(now())

  @@index([curriculumId])
  @@index([instanceId])
  @@map("curriculum_images")
}

model ElementProgress {
  id              String               @id @default(cuid())
  studentId       String
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  elementId       String
  element         CurriculumElement    @relation(fields: [elementId], references: [id], onDelete: Cascade)
  instanceId      String
  status          ElementProgressStatus @default(NOT_STARTED)
  progressPercent Int                  @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime             @updatedAt

  @@unique([studentId, elementId])
  @@index([studentId])
  @@index([instanceId])
  @@map("element_progress")
}

model CourseProgress {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId          String
  instanceId        String
  totalRequired     Int      @default(0)
  completedRequired Int      @default(0)
  percent           Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([studentId, courseId])
  @@index([instanceId])
  @@map("course_progress")
}

model VideoJob {
  id              String         @id @default(cuid())
  instanceId      String
  curriculumId    String
  elementId       String         @unique
  status          VideoJobStatus @default(PENDING)
  fileObjectKey   String?
  youtubeVideoId  String?
  bundleJson      Json?
  bundleExpiresAt DateTime?
  error           String?
  attempts        Int            @default(0)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([instanceId, status])
  @@index([bundleExpiresAt])
  @@map("video_jobs")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model TierChangeLog {
  id           String   @id @default(cuid())
  instanceId   String
  instance     Instance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  fromTier     Tier
  toTier       Tier
  periodMonths Int?
  amountPaid   Int?
  changedBy    String
  createdAt    DateTime @default(now())

  @@index([instanceId])
  @@map("tier_change_logs")
}

model YoutubeChannelAuth {
  id            String   @id @default("singleton")
  clientId      String
  clientSecret  String
  refreshToken  String
  accessToken   String?
  scope         String
  expiresAt     DateTime?
  channelId     String?
  channelTitle  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("youtube_channel_auth")
}
