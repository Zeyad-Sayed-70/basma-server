# ─── App ──────────────────────────────────────────────
NODE_ENV=production
PORT=3099
API_SERVER_URL=https://api.basma.pro

# ─── Database (runs on internal port 5433) ────────────
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=basma
DB_USER=basma
DB_PASSWORD=basma_secret
DATABASE_URL=postgresql://basma:basma_secret@127.0.0.1:5433/basma?schema=public

# ─── Redis (runs on internal port 6380) ───────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# ─── MinIO (runs on internal port 9002) ───────────────
MINIO_ROOT_USER=basma
MINIO_ROOT_PASSWORD=basma_secret
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=basma
MINIO_SECRET_KEY=basma_secret
MINIO_BUCKET=basma-assets
MINIO_USE_SSL=false
# Served through Nginx: https://api.basma.pro/assets/...
MINIO_PUBLIC_URL=https://api.basma.pro/assets

# ─── Auth ─────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-not-for-production
JWT_EXPIRATION=7d

# ─── WhatsApp / Baileys ──────────────────────────────
REDIS_URL=redis://127.0.0.1:6380
WA_MESSAGE_RATE_LIMIT=12
WA_MAX_RECONNECT_ATTEMPTS=10
WA_RECONNECT_BASE_DELAY=1000

# ─── CORS / Frontend URLs ─────────────────────────────
FRONTEND_BASE_URL=https://basma.pro
ADMIN_BASE_URL=https://basma.pro/admin

# ─── Paymob ────────────────────────────────────────────
PAYMOB_ENCRYPTION_KEY=generate-a-32-char-key-here!!!!!
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_WEBHOOK_BASE_URL=https://api.basma.pro

# ─── AI Agent / OpenCode ────────────────────────────────
OPENCODE_SERVER_HOSTNAME=127.0.0.1
OPENCODE_SERVER_PORT=4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_ZEN_MODEL=deepseek-v4-flash-free

# ─── NVIDIA NIM (Fallback model) ────────────────────────
NIM_API_KEY=
NIM_MODEL=nvidia/deepseek-r1
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ─── YouTube (video pipeline) ─────────────────────────
# Fill these in Google Cloud Console → Credentials → OAuth 2.0 Client IDs
YT_CLIENT_ID=261568388748-ekkd2a00subapkb5nuj1egk9nmh2e3au.apps.googleusercontent.com
YT_CLIENT_SECRET=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
YT_ENCRYPTION_KEY=change-me-32character-key-here!
YT_COOKIES_FILE=./data/yt-cookies.txt
YT_COOKIES_REFRESH_ENABLED=true
YT_PROFILE_DIR=./data/pw-profile
YT_TEMP_DIR=./tmp/uploads
YT_UPLOAD_RATE_PER_MIN=10
YT_FORCE_IPV4=true
CAMOUFOX_INSTALL_DIR=

# ─── Upload limits ─────────────────────────────────────
MAX_VIDEO_UPLOAD_BYTES=4294967296

# ─── Admin ──────────────────────────────────────────────
ADMIN_EMAIL=admin@basma.app
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin

# ─── Custom Domain / White-Label ──────────────────────
APP_BASE_DOMAIN=basma.pro
DOMAIN_CHECK_API_KEY=dev-domain-check-key

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=log
